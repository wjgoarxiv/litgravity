{
  "name": "@litfamily/litgravity",
  "version": "0.1.0",
  "description": "Installer for LitGravity: skills, hooks and agents that help Google's Antigravity CLI (agy) plan, build, check and hand off work.",
  "keywords": [
    "antigravity",
    "agy",
    "coding-agent",
    "agent-skills",
    "hooks",
    "planning",
    "code-review",
    "research",
    "context-handoff",
    "korean"
  ],
  "type": "module",
  "bin": {
    "litgravity": "bin/litgravity.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check:version": "node scripts/check-version.mjs",
    "scan:legacy-tokens": "node scripts/scan-legacy-tokens.mjs",
    "validate": "node scripts/validate-plugin.mjs",
    "sync:fixtures": "node scripts/sync-fixtures.mjs"
  },
  "files": [
    "bin",
    "lib",
    "plugin",
    "README.md",
    "README_ko-KR.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "LitGravity contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjgoarxiv/litgravity.git"
  },
  "bugs": {
    "url": "https://github.com/wjgoarxiv/litgravity/issues"
  },
  "homepage": "https://github.com/wjgoarxiv/litgravity#readme"
}
