{
  "litgravity": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./hooks/session-start.mjs",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/pre-invocation.mjs",
        "timeout": 10
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/post-invocation.mjs",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/stop.mjs",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "invoke_subagent|define_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-use.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/post-tool-use.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
