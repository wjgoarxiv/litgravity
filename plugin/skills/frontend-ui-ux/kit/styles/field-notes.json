{
  "schema_id": "litfamily.frontend-style/v1",
  "id": "field-notes",
  "name": "Field notes",
  "summary": "The authored house look: warm paper, deep ink, a terracotta accent with a deep-teal second accent, mist as the quiet tint, thin rules instead of shadows, notebook-dot paper, a large editorial title and small lowercase terminal labels. Read-once pages carry an original pixel-art motif; work surfaces keep the palette and type and drop the art to a small accent.",
  "use_when": [
    "default for read-once pages (landing family) when the brief gives no visual direction: landing, launch, portfolio, docs home, reports",
    "the brief asks for an editorial, warm-paper or pixel-art voice on any surface"
  ],
  "avoid_when": [
    "work surfaces with no direction (graphite is their default)",
    "the brief or an existing brand names other colours or type"
  ],
  "keywords": [
    "field-notes",
    "field notes",
    "pixel art",
    "픽셀 아트",
    "픽셀아트"
  ],
  "signature": [
    "warm paper, deep ink, a terracotta accent with a deep-teal second accent, and mist as the quiet tint",
    "thin 1 px rules instead of shadows on read-once pages",
    "small lowercase mono labels",
    "an original pixel motif on read-once pages (section 5 of house-styles.md)",
    "notebook-dot paper and a warm accent glow on the one atmosphere surface (rich density; a calm lock drops both)"
  ],
  "forbid": [
    "heavy or coloured shadows on controls, and glass",
    "violet-to-blue gradients, or gradient text in colours the palette does not own",
    "stock illustration or emoji in place of the pixel motif"
  ],
  "fonts": {
    "text": "Pretendard",
    "display": "Pretendard",
    "mono": "JetBrains Mono"
  },
  "type": {
    "scale_px": {
      "xs": 12,
      "sm": 13,
      "md": 14,
      "base": 16,
      "lg": 18,
      "xl": 20,
      "2xl": 24,
      "3xl": 30,
      "4xl": 38,
