    "sm": 6,
    "md": 8,
    "lg": 12,
    "pill": 999
  },
  "shadow": {
    "raised": "0 1px 2px rgb(18 21 25 / 0.06), 0 1px 1px rgb(18 21 25 / 0.04)",
    "overlay": "0 16px 40px -12px rgb(18 21 25 / 0.28), 0 2px 6px rgb(18 21 25 / 0.08)"
  },
  "motion": {
    "fast_ms": 120,
    "ui_ms": 180,
    "enter_ms": 420,
    "exit_ms": 160,
    "ease": "cubic-bezier(0.22, 0.8, 0.24, 1)"
