{
  "schema_id": "litfamily.frontend-style/v1",
  "id": "graphite",
  "name": "Graphite",
  "summary": "A neutral, precise register: cool greys, white surfaces, a blue accent with a rose second accent for highlights and featured bands, crisp 6 to 8 px radii, soft two-layer elevation. Built for tools people work in all day and for products whose audience expects a quiet professional surface.",
  "use_when": [
    "default for work surfaces (workspace and settings families) when the brief gives no visual direction: dashboards, settings, forms, admin and data-dense screens",
    "the brief asks for neutral, corporate, enterprise, clinical, financial or developer-tool tone",
    "dense work surfaces where colour must be reserved for status"
  ],
  "avoid_when": [
    "the brief asks for warmth, play or an editorial voice"
  ],
  "keywords": [
    "graphite",
    "그래파이트"
  ],
  "signature": [
    "cool greys, white surfaces, a blue accent and a rose second accent",
    "6 to 8 px radii and a soft two-layer elevation",
    "colour on actions, status, featured bands and charts; dense table cells and form chrome stay neutral"
  ],
  "forbid": [
    "offset or coloured shadows on controls, and glass",
    "accent fills on table cells, list rows and form chrome",
    "more than four accent hue families in one view"
  ],
  "fonts": {
    "text": "Pretendard",
    "display": "Pretendard",
    "mono": "JetBrains Mono"
  },
  "type": {
    "scale_px": {
      "xs": 12,
      "sm": 13,
      "md": 14,
      "base": 16,
      "lg": 18,
      "xl": 20,
      "2xl": 24,
      "3xl": 30,
      "4xl": 38,
      "5xl": 48
    },
    "display_px": {
      "min": 36,
      "max": 64
    },
    "moment_px": {
      "max": 88
    },
    "weights": {
      "text": 400,
      "medium": 500,
      "strong": 600,
      "display": 680
    },
    "tracking_em": {
      "display": -0.025,
      "label": 0
    },
    "leading": {
      "body": 1.6,
      "tight": 1.3,
      "display_latin": 1.05,
      "display_korean": 1.18
    }
  },
  "space_px": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48,
    64,
    80,
    96,
