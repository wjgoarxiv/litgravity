{
  "schema_id": "litfamily.frontend-style/v1",
  "id": "meadow",
  "name": "Meadow",
  "summary": "A warm, approachable register for consumer products: near-white canvas, deep teal accent, a coral second accent, sand as the tint, generous 12 to 18 px radii and soft elevation. Friendly without turning casual where money or health is at stake.",
  "use_when": [
    "opt-in only: the brief asks for friendly, warm, approachable, consumer, education, wellness, food or hospitality tone"
  ],
  "avoid_when": [
    "dense all-day work surfaces",
    "financial or clinical tasks where a casual register costs trust"
  ],
  "keywords": [
    "meadow",
    "메도우"
  ],
  "signature": [
    "near-white canvas, deep teal accent, coral second accent, sand tint",
    "12 to 18 px radii with soft elevation",
    "rounded, generous spacing with tinted bands between sections"
  ],
  "forbid": [
    "hard offset shadows and thick outlines",
    "more than four accent hue families in one view",
    "square, ruled compartments (that is computational-brutalism)"
  ],
  "fonts": {
    "text": "Pretendard",
    "display": "Pretendard",
    "mono": "JetBrains Mono"
  },
