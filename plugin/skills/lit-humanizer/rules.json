      "flags": "im",
      "scope": "line",
      "context": [
        "fenced_code",
        "quoted_user_text",
        "table_figure_caption"
      ],
      "rationale": "A bare source label is a block in prose, with a narrow exemption for a plain attribution directly attached to a table, image, or figure; caveat-bearing labels still block.",
      "fixture_ids": [
        "ko-plain-meta-label:positive",
        "ko-plain-meta-label:negative"
