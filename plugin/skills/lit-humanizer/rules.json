{
  "schema_version": 1,
  "description": "Phase A rules are line-scoped editing signals, not authorship or quality scores.",
  "context_policy": {
    "fenced_code": "Skip fenced regions while retaining original line numbers.",
    "quoted_user_text": "Skip Markdown blockquote lines as a conservative proxy; adapters should pass provenance for exact user-quote boundaries.",
    "table_figure_caption": "Skip label checks in recognizable table/figure captions, where source attribution is valid."
  },
  "rules": [
    {
      "id": "ko-bold-deliverable-label",
      "lang": "ko",
      "severity": "block",
      "pattern": "^\\s*(?:[-*]\\s+)?\\*\\*(?:증거|근거|검증(?:\\s*상태)?|확인\\s*상태|신뢰도|출처|한계|제한\\s*사항|면책)\\s*[:：]\\*\\*",
      "flags": "im",
      "scope": "line",
      "context": [
        "fenced_code",
        "quoted_user_text",
        "table_figure_caption"
      ],
      "rationale": "A bold standalone evidence or limitation label reads like internal scaffolding in a deliverable.",
      "fixture_ids": [
        "ko-bold-deliverable-label:positive",
        "ko-bold-deliverable-label:negative"
      ]
    },
    {
      "id": "en-bold-deliverable-label",
      "lang": "en",
      "severity": "block",
