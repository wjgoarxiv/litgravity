{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "litfamily.design-contract/v1beta2",
  "title": "LitFamily Design Contract v1beta2",
  "description": "v1beta1 plus one optional taste object. Additive only: every valid v1beta1 document stays valid after changing schema_id, and a v1beta2 document that omits taste is complete. Referential integrity, auth coupling, and global identifier uniqueness remain executable semantic rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "contract_id", "source_hash", "intent", "direction", "inventory",
    "accessibility", "localization", "performance", "evidence_policy", "omissions",
    "accepted_exceptions", "lane", "tokens", "component_behaviors",
    "responsive_transformations", "motion", "acceptance_criteria"
  ],
  "properties": {
    "schema_id": { "const": "litfamily.design-contract/v1beta2" },
    "contract_id": { "type": "string", "pattern": "^contract:[a-z0-9][a-z0-9._/-]*$" },
    "source_hash": { "$ref": "#/$defs/hash" },
    "intent": { "$ref": "#/$defs/intent" },
    "direction": { "$ref": "#/$defs/direction" },
    "taste": { "$ref": "#/$defs/taste" },
    "inventory": { "$ref": "#/$defs/inventory" },
    "accessibility": { "$ref": "#/$defs/accessibility" },
    "localization": { "$ref": "#/$defs/localization" },
    "performance": { "$ref": "#/$defs/performance" },
    "evidence_policy": { "$ref": "#/$defs/evidencePolicy" },
    "omissions": { "$ref": "#/$defs/scopeRecords" },
    "accepted_exceptions": { "$ref": "#/$defs/scopeRecords" },
    "lane": { "enum": ["new-build", "brownfield", "redesign", "reference-fidelity", "design-system"] },
    "tokens": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "category", "value", "usage"],
        "properties": {
          "id": { "type": "string", "pattern": "^token:[a-z0-9][a-z0-9._/-]*$" },
          "category": { "enum": ["color", "typography", "spacing", "radius", "shadow", "motion", "other"] },
          "value": { "$ref": "#/$defs/text" },
          "usage": { "$ref": "#/$defs/text" }
        }
      }
    },
    "component_behaviors": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["component_id", "state_ids", "interaction_ids", "keyboard_behavior"],
        "properties": {
          "component_id": { "type": "string", "pattern": "^component:[a-z0-9][a-z0-9._/-]*$" },
          "state_ids": { "$ref": "#/$defs/stateIdList" },
          "interaction_ids": { "$ref": "#/$defs/interactionIdList" },
          "keyboard_behavior": { "$ref": "#/$defs/text" }
        }
      }
    },
    "responsive_transformations": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["route_id", "viewport_id", "behavior"],
        "properties": {
          "route_id": { "type": "string", "pattern": "^route:[a-z0-9][a-z0-9._/-]*$" },
          "viewport_id": { "type": "string", "pattern": "^viewport:[a-z0-9][a-z0-9._/-]*$" },
          "behavior": { "$ref": "#/$defs/text" }
        }
      }
    },
    "motion": {
      "type": "object", "additionalProperties": false,
      "required": ["policy", "reduced_motion_behavior", "transitions"],
      "properties": {
        "policy": { "enum": ["none", "functional", "expressive"] },
        "reduced_motion_behavior": { "$ref": "#/$defs/text" },
        "transitions": {
          "type": "array", "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "interaction_id", "duration_ms", "easing"],
            "properties": {
              "id": { "type": "string", "pattern": "^transition:[a-z0-9][a-z0-9._/-]*$" },
              "interaction_id": { "type": "string", "pattern": "^interaction:[a-z0-9][a-z0-9._/-]*$" },
              "duration_ms": { "type": "integer", "minimum": 0, "maximum": 10000 },
              "easing": { "$ref": "#/$defs/text" }
            }
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "observable", "verification", "required", "inventory_ids"],
        "properties": {
          "id": { "type": "string", "pattern": "^criterion:[a-z0-9][a-z0-9._/-]*$" },
          "observable": { "$ref": "#/$defs/text" },
          "verification": { "enum": ["tests", "browser", "keyboard", "accessibility-tree", "screen-reader", "performance", "localization", "manual"] },
          "required": { "const": true },
          "inventory_ids": { "$ref": "#/$defs/idList" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S(?:[^\\n\\r\\t]*\\S)?$" },
    "timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "taste": {
      "type": "object", "additionalProperties": false,
      "description": "Direction as three numbers a reviewer can argue with. Declaring taste means declaring all three; omitting the object entirely leaves the harness default in force.",
      "required": ["variance", "motion", "density"],
      "properties": {
        "variance": {
          "type": "integer", "minimum": 1, "maximum": 10,
          "description": "How far layout and composition may depart from the most conventional arrangement."
        },
        "motion": {
          "type": "integer", "minimum": 1, "maximum": 10,
          "description": "How much animation carries meaning. Bounded independently of motion.policy, which decides whether motion is allowed at all."
        },
        "density": {
          "type": "integer", "minimum": 1, "maximum": 10,
          "description": "How much information occupies a given area before the layout is considered crowded."
        }
      }
    },
    "requiredPhrases": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "optionalPhrases": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "intent": {
      "type": "object", "additionalProperties": false,
      "required": ["audiences", "tasks", "qualities", "constraints", "non_goals"],
      "properties": {
        "audiences": { "$ref": "#/$defs/requiredPhrases" },
        "tasks": { "$ref": "#/$defs/requiredPhrases" },
        "qualities": { "$ref": "#/$defs/requiredPhrases" },
        "constraints": { "$ref": "#/$defs/optionalPhrases" },
        "non_goals": { "$ref": "#/$defs/optionalPhrases" }
      }
    },
    "direction": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "principles", "token_strategy", "voice"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "principles": {
          "type": "array", "minItems": 3, "maxItems": 7, "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "token_strategy": { "enum": ["reuse", "extend", "create"] },
        "voice": { "$ref": "#/$defs/text" }
      }
    },
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "primary", "auth_required"],
      "properties": {
        "id": { "type": "string", "pattern": "^route:[a-z0-9][a-z0-9._/-]*$" },
        "path": { "$ref": "#/$defs/text" }, "primary": { "type": "boolean" },
        "auth_required": { "type": "boolean" }
      }
    },
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "route_id", "purpose"],
      "properties": {
        "id": { "type": "string", "pattern": "^region:[a-z0-9][a-z0-9._/-]*$" },
        "route_id": { "type": "string", "pattern": "^route:[a-z0-9][a-z0-9._/-]*$" },
        "purpose": { "$ref": "#/$defs/text" }
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "region_id", "role"],
      "properties": {
        "id": { "type": "string", "pattern": "^component:[a-z0-9][a-z0-9._/-]*$" },
        "region_id": { "type": "string", "pattern": "^region:[a-z0-9][a-z0-9._/-]*$" },
        "role": { "$ref": "#/$defs/text" }
      }
    },
    "interaction": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "route_id", "critical", "input_modes"],
      "properties": {
        "id": { "type": "string", "pattern": "^interaction:[a-z0-9][a-z0-9._/-]*$" },
        "route_id": { "type": "string", "pattern": "^route:[a-z0-9][a-z0-9._/-]*$" },
        "critical": { "type": "boolean" },
        "input_modes": {
          "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
          "items": { "enum": ["keyboard", "pointer", "touch", "voice", "switch"] }
        }
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "route_id", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^state:[a-z0-9][a-z0-9._/-]*$" },
        "route_id": { "type": "string", "pattern": "^route:[a-z0-9][a-z0-9._/-]*$" },
        "kind": { "enum": ["loading", "empty", "error", "success", "disabled", "permission", "offline", "ready"] }
      }
    },
    "viewport": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "width_px", "height_px"],
      "properties": {
        "id": { "type": "string", "pattern": "^viewport:[a-z0-9][a-z0-9._/-]*$" },
        "category": { "enum": ["compact", "medium", "expanded"] },
        "width_px": { "type": "integer", "minimum": 240, "maximum": 7680 },
        "height_px": { "type": "integer", "minimum": 240, "maximum": 4320 }
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "sha256", "provenance"],
      "properties": {
        "id": { "type": "string", "pattern": "^reference:[a-z0-9][a-z0-9._/-]*$" },
        "kind": { "enum": ["user-provided", "repo-local", "generated", "measured"] },
        "sha256": { "$ref": "#/$defs/hash" }, "provenance": { "$ref": "#/$defs/text" }
      }
    },
    "authenticatedSurface": {
      "type": "object", "additionalProperties": false,
      "required": ["route_id", "safe_test_account"],
      "properties": {
        "route_id": { "type": "string", "pattern": "^route:[a-z0-9][a-z0-9._/-]*$" },
        "safe_test_account": { "const": true }
      }
    },
    "inventory": {
      "type": "object", "additionalProperties": false,
      "required": ["routes", "regions", "components", "interactions", "states", "viewports", "references", "authenticated_surfaces"],
      "properties": {
        "routes": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/route" } },
        "regions": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/region" } },
        "components": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "$ref": "#/$defs/component" } },
        "interactions": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/interaction" } },
        "states": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/state" } },
        "viewports": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "$ref": "#/$defs/viewport" } },
        "references": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/reference" } },
        "authenticated_surfaces": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/authenticatedSurface" } }
      }
    },
    "accessibility": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "keyboard", "screen_reader", "reduced_motion", "forced_colors", "zoom_percent"],
      "properties": {
        "target": { "const": "WCAG 2.2 AA" }, "keyboard": { "type": "boolean" },
        "screen_reader": { "type": "boolean" }, "reduced_motion": { "type": "boolean" },
        "forced_colors": { "type": "boolean" },
        "zoom_percent": { "type": "integer", "minimum": 200, "maximum": 400 }
      }
    },
    "localization": {
      "type": "object", "additionalProperties": false,
      "required": ["locales", "text_expansion_percent", "cjk_line_break_review", "font_fallback_review", "ime_review", "rtl_review"],
      "properties": {
        "locales": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$" }
        },
        "text_expansion_percent": { "type": "integer", "minimum": 0, "maximum": 300 },
        "cjk_line_break_review": { "type": "boolean" }, "font_fallback_review": { "type": "boolean" },
        "ime_review": { "type": "boolean" }, "rtl_review": { "type": "boolean" }
      }
    },
    "performance": {
      "type": "object", "additionalProperties": false,
      "required": ["lcp_ms", "cls", "inp_ms", "initial_js_kb", "initial_css_kb"],
      "properties": {
        "lcp_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "cls": { "type": "number", "minimum": 0, "maximum": 1 },
        "inp_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "initial_js_kb": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "initial_css_kb": { "type": "integer", "minimum": 0, "maximum": 1048576 }
      }
    },
    "evidencePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["independent_review_required", "required_channels", "cleanup_required"],
      "properties": {
        "independent_review_required": { "type": "boolean" },
        "required_channels": {
          "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true,
          "items": { "enum": ["tests", "browser", "keyboard", "accessibility-tree", "screen-reader", "performance", "localization"] }
        },
        "cleanup_required": { "type": "boolean" }
      }
    },
    "scopeRecords": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/scopeRecord" } },
    "scopeRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "reason", "owner"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "reason": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" }, "expires_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "idList": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "stateIdList": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^state:[a-z0-9][a-z0-9._/-]*$" } },
    "interactionIdList": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^interaction:[a-z0-9][a-z0-9._/-]*$" } }
  }
}
